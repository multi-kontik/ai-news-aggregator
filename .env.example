DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ai_news_aggregator

# Optional: route YouTube transcript requests through a Webshare proxy
# (https://www.webshare.io/) to work around YouTube IP-blocking transcript
# fetches. Leave both unset to fetch transcripts directly, no proxy.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Required for stage 3 (scripts/process_digest.py) — used by the openai SDK directly.
OPENAI_API_KEY=
