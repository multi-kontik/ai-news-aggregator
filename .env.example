DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ai_news_aggregator

# Optional: route YouTube transcript requests through a Webshare proxy
# (https://www.webshare.io/) to work around YouTube IP-blocking transcript
# fetches. Leave both unset to fetch transcripts directly, no proxy.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Required for stage 3 (scripts/process_digest.py) — used by the openai SDK directly.
OPENAI_API_KEY=

# Required for stage 5 (scripts/send_digest.py), sending the daily email via
# Resend (https://resend.com/). EMAIL_TO is the recipient. EMAIL_FROM defaults
# to Resend's test sender, which only delivers to your own Resend account
# email; set it to an address on a verified domain to send anywhere.
RESEND_API_KEY=
EMAIL_TO=
# EMAIL_FROM=AI News Digest <digest@your-verified-domain.com>
