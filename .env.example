# Local database from docker/docker-compose.yml. On Render this is set
# automatically from the Render Postgres database (see render.yaml).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ai_news_aggregator

# Needed for YouTube videos: a YouTube Data API v3 key, used to list each
# channel's latest uploads. YouTube's public RSS feeds return 404s, so without
# it no videos come through. Create one in Google Cloud: APIs & Services ->
# Library -> "YouTube Data API v3" -> Enable, then Credentials -> Create
# credentials -> API key. Restrict it to the YouTube Data API v3.
YOUTUBE_API_KEY=

# Optional locally, but needed on Render for transcripts: route YouTube's
# own requests (transcripts, plus channel pages and feeds when there's no API
# key) through Webshare's rotating residential
# proxy (https://www.webshare.io/). YouTube blocks most datacenter IPs and
# rate-limits busy ones. Use a "Residential" plan, not "Proxy Server" or
# "Static Residential". The username and password are in Webshare's Proxy
# Settings. Leave both unset to connect to YouTube directly.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Optional: only rotate through IPs in these countries, e.g. us,ca
# WEBSHARE_PROXY_COUNTRIES=us,ca

# Required: used by every agent (summaries, ranking, email introduction).
OPENAI_API_KEY=

# Required to send the daily email (`ai-news run` / `ai-news send`) via
# Resend (https://resend.com/). EMAIL_TO is the recipient. EMAIL_FROM defaults
# to Resend's test sender, which only delivers to your own Resend account
# email; set it to an address on a verified domain to send anywhere.
RESEND_API_KEY=
EMAIL_TO=
# EMAIL_FROM=AI News Digest <digest@your-verified-domain.com>
